# ---------------------------------------------------------------------------
# GamersPulse environment configuration
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed.
#
# IMPORTANT: Never invent the values below. Both the AdSense publisher ID and
# the contact address must be the real values issued to you by Google AdSense
# and by you respectively. Placeholders are rejected at runtime — see
# lib/site.ts.
# ---------------------------------------------------------------------------

# Google AdSense publisher ID.
# Format: ca-pub-<digits>. Supplied by Google AdSense when your account is
# approved. Used for:
#   - loading adsbygoogle.js
#   - generating /ads.txt  (the pub- part becomes the ads.txt directive)
# If unset, the AdSense script is not emitted and /ads.txt is served with a
# commented-out template plus setup instructions rather than a fake directive.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Editorial contact address shown on /contact, /editorial-policy and
# /corrections. Categories are distinguished by the subject line prefix.
# If unset, those pages render an explicit "not yet configured" notice and no
# address is shown — nothing is fabricated.
NEXT_PUBLIC_CONTACT_EMAIL=